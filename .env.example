# Porta do servidor Hono
PORT=4000

# Segredo compartilhado com o frontend (BFF). OBRIGATÓRIO — se vazio, o backend
# recusa todas as requisições (403). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deve ser idêntico ao INTERNAL_API_SECRET do frontend.
INTERNAL_API_SECRET=""

# Neon Postgres (com pgvector). Pegue em https://neon.tech -> projeto -> Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Google Gemini (free tier, sem cartão). Gere em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Sessão efêmera: no reset, documentos mais antigos que isto são removidos (horas).
SESSION_TTL_HOURS="2"
